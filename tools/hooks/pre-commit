#!/usr/bin/env bash
# lbtvg pre-commit, for commits that touch src/ or the name lists
# (tools/symbols/confirmed.txt, rejected.txt):
#   0. name lists changed: re-run tools/macnames.py (needs the Mac binary in
#      orig/donors/) and stage tools/symbols/pc-names.csv
#   1. clang-format the staged sources (re-staged; files with unstaged edits
#      are only checked, so nothing you didn't stage sneaks in)
#   2. re-run the match harness on them (whole tree if a header changed);
#      refuse the commit if a // FUNCTION: no longer matches
#   3. regenerate the README badge, docs/todo.md and site/data.json into it
# Install once with `make hooks`. Emergency bypass: git commit --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# need the devshell (lief/pefile/capstone, clang-format, wibo, VC8 env)
if ! python3 -c 'import lief, pefile, capstone' 2>/dev/null || ! command -v clang-format >/dev/null; then
  exec nix develop --command "$0" "$@"
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR -- src/)
names=$(git diff --cached --name-only --diff-filter=ACMR -- tools/symbols/confirmed.txt tools/symbols/rejected.txt)
[ -z "$staged" ] && [ -z "$names" ] && exit 0

# 0. names
if [ -n "$names" ]; then
  if [ -f "orig/donors/mac/LEGO Batman" ]; then
    echo "pre-commit: name lists changed; re-pairing Mac names"
    tools/macnames.py 2>&1 | tail -1
    git add tools/symbols/pc-names.csv
  else
    echo "pre-commit: name lists changed but orig/donors/mac/LEGO Batman is missing; run make macnames elsewhere" >&2
  fi
fi

# 1. format
code=$(printf '%s\n' $staged | grep -E '\.(c|cpp|h)$' || true)
for f in $code; do
  if git diff --quiet -- "$f"; then
    clang-format -i "$f" && git add "$f"
  elif ! clang-format --dry-run -Werror "$f" 2>/dev/null; then
    echo "pre-commit: $f is not formatted and has unstaged edits; run make fmt and stage it" >&2
    exit 1
  fi
done

# 2. match
srcs=$(printf '%s\n' $code | grep -E '\.(c|cpp)$' || true)
VC8=${VC8:-toolchain/vc8}
if [ -n "$code" ] && [ -f "$VC8/Bin/cl.exe" ]; then
  printf '%s\n' $code | grep -qE '\.h$' && srcs=""     # header changed: check every TU
  mkdir -p build
  if ! NO_COLOR=1 tools/match.py $srcs > build/pre-commit-match.log 2>&1; then
    grep -E '^DIFF' build/pre-commit-match.log || tail -20 build/pre-commit-match.log
    echo "pre-commit: functions above no longer match; fix them or mark them // STUB:" >&2
    exit 1
  fi
  echo "pre-commit: $(tail -1 build/pre-commit-match.log)"
elif [ -n "$code" ]; then
  echo "pre-commit: no VC8 toolchain (make vc8); skipping the match check" >&2
fi

# 3. progress
tools/progress.py --write
git add README.md docs/todo.md site/data.json

#!/usr/bin/env bash
# lbtvg pre-commit: when src/ changes, check the staged sources still match,
# then regenerate the progress badge, map and todo list into this commit.
# Install once with `make hooks`. Skip in an emergency with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# need the devshell (lief/pefile/capstone, wibo, VC8 env); re-enter it if absent
if ! python3 -c 'import lief, pefile, capstone' 2>/dev/null; then
  exec nix develop --command "$0" "$@"
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR -- src/)
[ -z "$staged" ] && exit 0

srcs=$(printf '%s\n' $staged | grep -E '\.(c|cpp)$' || true)
if [ -n "$srcs" ] && [ -x "${VC8:-toolchain/vc8}/Bin/cl.exe" -o -f "${VC8:-toolchain/vc8}/Bin/cl.exe" ]; then
  echo "pre-commit: matching $(echo "$srcs" | wc -l) staged source file(s)"
  # headers changed too? then every TU could be affected: check the whole tree
  if printf '%s\n' $staged | grep -qE '\.h$'; then srcs=""; fi
  mkdir -p build
  if ! tools/match.py $srcs > build/pre-commit-match.log 2>&1; then
    grep -E '^DIFF' build/pre-commit-match.log || tail -20 build/pre-commit-match.log
    echo "pre-commit: functions above no longer match; fix them or mark them // STUB:" >&2
    exit 1
  fi
  tail -1 build/pre-commit-match.log
elif [ -n "$srcs" ]; then
  echo "pre-commit: no VC8 toolchain (make vc8); skipping the match check" >&2
fi

tools/progress.py --write
git add README.md docs/progress.svg docs/todo.md
